# Anthropic — powers the agent loop.
# Leave unset if you've run `ant auth login`; the SDK picks up the profile.
ANTHROPIC_API_KEY=

# Model + effort for the dispatcher and worker agents.
AGENTDISPATCH_MODEL=claude-opus-5
AGENTDISPATCH_EFFORT=high

# Google OAuth — download the "Desktop app" client JSON from
# console.cloud.google.com > APIs & Services > Credentials, and point here.
GOOGLE_CLIENT_SECRETS=./secrets/client_secret.json

# Where the OAuth refresh token is cached after the first browser consent.
GOOGLE_TOKEN_PATH=./secrets/token.json

# Where tasks and their results are persisted.
AGENTDISPATCH_DB=./agentdispatch.db
